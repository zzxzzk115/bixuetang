{
  "manifest_version": 3,
  "name": "学者公会 · 学习进度同步",
  "version": "1.0.0",
  "description": "在 bilibili / YouTube 原站看公开课时，自动把观看进度同步回学者公会（Guild）。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://www.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "学者公会进度同步" },
  "options_page": "options.html"
}
